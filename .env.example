# Leave empty to use the embedded PGlite database in ./.data/pglite (local dev).
# For production use a Postgres URL (e.g. Neon pooled connection string).
DATABASE_URL=
# Optional non-pooled URL used only by `npm run db:migrate` (Supabase: port 5432).
DIRECT_URL=

# Which live data source the ingest cron uses. Only "mock" exists for now.
LIVE_SOURCE=mock

# Protects /api/cron/ingest. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=change-me

# Protects /api/admin/* (creating API keys).
ADMIN_TOKEN=change-me-too
