# Leave empty to use the embedded PGlite database in ./.data/pglite (local dev).
# For production use a Postgres URL (e.g. Neon pooled connection string).
DATABASE_URL=
# Optional non-pooled URL used only by `npm run db:migrate` (Supabase: port 5432).
DIRECT_URL=

# "mock" = fake data (ingest cron), "tiktok" = real LIVE data (/api/cron/live), comma-separated, or "none".
# Switching away from "mock" makes the ingest cron delete leftover mock data.
LIVE_SOURCE=mock

# Optional Euler Stream API key (higher signing limits). Without it the free community tier is used.
EULER_API_KEY=

# Protects /api/cron/ingest. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=change-me

# Protects /api/admin/* (creating API keys).
ADMIN_TOKEN=change-me-too

# Days of single gift events (with gifter names) to keep for rankings.
GIFT_RETENTION_DAYS=90

# Days of chat history to keep.
CHAT_RETENTION_DAYS=30

# --- TikTok Login Kit (https://developers.tiktok.com → your app → Login Kit) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Public base URL; the redirect URI registered at TikTok must be exactly
# $APP_URL/api/auth/tiktok/callback (or set TIKTOK_REDIRECT_URI explicitly).
APP_URL=https://your-app.vercel.app
# Must include a scope that returns `username`. Adjust if TikTok names it differently.
TIKTOK_SCOPES=user.info.basic,user.info.profile

# Local only: fake login form without TikTok (ignored in production builds).
ALLOW_DEV_LOGIN=1

# --- Video recording of own streams (Supabase Storage, private bucket "recordings") ---
# Supabase → Project Settings → API: project URL and the service_role key (server-only, keep secret).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VIDEO_RETENTION_DAYS=14
